# Public URL of the deployed site, without a trailing slash. Used for canonical
# URLs, hreflang, Open Graph, the sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=https://nadeem-marble.vercel.app

# Optional: Web3Forms access key for direct email delivery of the contact form.
# Leave empty to keep the default WhatsApp / email hand-off (nothing is sent
# by the website itself). Web3Forms access keys are designed to be public.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
